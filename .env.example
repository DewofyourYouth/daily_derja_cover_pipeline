# Copy to .env and fill in. Only needed for `cover.py prompt` WITHOUT --art
# (photo mode, title mode and prompt --art need no keys).

# Gemini / Nano Banana — default prompt-mode backend (true 16:9 / 2K).
#   key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI / GPT Image 2 — optional (--provider openai). Note: emits 3:2, not true 16:9.
#   key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# OpenRouter — default for jobs with reference photos. Either key spelling works.
#   key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPEN_ROUTER_API_KEY=             # accepted alias used by older local setups

# Quality-first reference slate; one candidate per model by default.
# OPENROUTER_REFERENCE_MODELS=google/gemini-3-pro-image,openai/gpt-image-2,black-forest-labs/flux.2-pro
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OPENROUTER_TIMEOUT_SECONDS=180
# OPENROUTER_MAX_WORKERS=3
